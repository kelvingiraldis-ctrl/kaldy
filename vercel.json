{
  "trailingSlash": true,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/marketing/"
    },
    {
      "source": "/styles.css",
      "destination": "/marketing/styles.css"
    },
    {
      "source": "/script.js",
      "destination": "/marketing/script.js"
    },
    {
      "source": "/fotos/:path*",
      "destination": "/marketing/fotos/:path*"
    },
    {
      "source": "/Brenda Kaldy.jpg",
      "destination": "/marketing/Brenda Kaldy.jpg"
    },
    {
      "source": "/Brenda Kaldy 02.jpg",
      "destination": "/marketing/Brenda Kaldy 02.jpg"
    }
  ]
}
